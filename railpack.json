{
  "$schema": "https://schema.railpack.com",
  "buildAptPackages": ["ca-certificates", "curl"],
  "steps": {
    "install": {
      "commands": [
        {
          "src": "email_agent.gemspec",
          "dest": "email_agent.gemspec"
        },
        {
          "src": "lib/email_agent/version.rb",
          "dest": "lib/email_agent/version.rb"
        },
        "..."
      ]
    },
    "build": {
      "commands": [
        "...",
        {
          "customName": "Install whisper.cpp v1.9.1 and multilingual base model",
          "cmd": "sh bin/install_whisper"
        }
      ]
    }
  },
  "deploy": {
    "aptPackages": ["ffmpeg", "libjemalloc2"]
  }
}
