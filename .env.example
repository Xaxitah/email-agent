# Copie para .env apenas no ambiente local. No Railway, configure Variables.
ACCOUNT_COUNT=1

ACCOUNT_1_NAME=Gmail
ACCOUNT_1_HOST=imap.gmail.com
ACCOUNT_1_PORT=993
ACCOUNT_1_USER=voce@example.com
ACCOUNT_1_PASSWORD=senha-de-aplicativo

TELEGRAM_BOT_TOKEN=token-do-bot
TELEGRAM_CHAT_ID=id-do-chat-autorizado

# IA opcional. Sem chave, o bot usa o resumo local deterministico.
# DeepSeek e o provedor recomendado para esta configuracao.
AI_PROVIDER=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# Permite enviar o corpo dos e-mails ao provedor para gerar o resumo.
# Deixe false para enviar somente remetente, assunto, data e categorias.
AI_INCLUDE_EMAIL_BODY=false
AI_EMAIL_BODY_MAX_CHARS=4000

# Alternativa opcional ao DeepSeek:
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Transcricao local de mensagens de voz pelo whisper.cpp no Railway.
VOICE_TRANSCRIPTION_ENABLED=false
VOICE_LANGUAGE=pt
VOICE_MAX_SECONDS=120
VOICE_MAX_BYTES=8388608
VOICE_TRANSCRIPTION_TIMEOUT=180
WHISPER_THREADS=2

# Leitura automatica no fuso definido por TZ. O volume Railway deve estar em /data.
TZ=America/Asuncion
SCHEDULE_ENABLED=true
SCHEDULE_STATE_PATH=/data/scheduler-state.json
SCHEDULE_EMAIL_LIMIT=200
SCHEDULE_CATCHUP_MINUTES=180
